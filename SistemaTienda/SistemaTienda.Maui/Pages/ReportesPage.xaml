<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SistemaTienda.Maui.Models"
             x:Class="SistemaTienda.Maui.Pages.ReportesPage"
             Title="Reportes">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Reportes" Style="{StaticResource TituloPagina}" />
                    <Label x:Name="UsuarioLabel" Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Actualizar"
                        Style="{StaticResource BotonSecundario}"
                        WidthRequest="104"
                        HeightRequest="42"
                        VerticalOptions="Center"
                        Clicked="OnActualizarClicked" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button x:Name="HoyButton"
                        Text="Hoy"
                        Style="{StaticResource BotonPrincipal}"
                        HeightRequest="40"
                        Clicked="OnHoyClicked" />
                <Button x:Name="MesButton"
                        Grid.Column="1"
                        Text="Este mes"
                        Style="{StaticResource BotonSecundario}"
                        HeightRequest="40"
                        Clicked="OnMesClicked" />
                <Button x:Name="RangoButton"
                        Grid.Column="2"
                        Text="Rango"
                        Style="{StaticResource BotonSecundario}"
                        HeightRequest="40"
                        Clicked="OnRangoClicked" />
            </Grid>

            <Button x:Name="CompararButton"
                    Text="Comparar con periodo anterior"
                    Style="{StaticResource BotonSecundario}"
                    HeightRequest="40"
                    Clicked="OnCompararClicked" />

            <Border x:Name="ComparacionPanel"
                    IsVisible="False"
                    Style="{StaticResource Tarjeta}"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="COMPARACIÓN CON EL PERIODO ANTERIOR"
                           Style="{StaticResource EtiquetaSeccion}" />
                    <Label x:Name="ComparacionPeriodoLabel" Style="{StaticResource TextoNota}" />

                    <Grid ColumnDefinitions="1.4*,*,*,1.1*" ColumnSpacing="6">
                        <Label Text="CONCEPTO" Style="{StaticResource EtiquetaSeccion}" />
                        <Label Grid.Column="1" Text="ACTUAL" Style="{StaticResource EtiquetaSeccion}"
                               HorizontalTextAlignment="End" />
                        <Label Grid.Column="2" Text="ANTERIOR" Style="{StaticResource EtiquetaSeccion}"
                               HorizontalTextAlignment="End" />
                        <Label Grid.Column="3" Text="Δ" Style="{StaticResource EtiquetaSeccion}"
                               HorizontalTextAlignment="End" />
                    </Grid>

                    <Grid ColumnDefinitions="1.4*,*,*,1.1*" ColumnSpacing="6">
                        <Label Text="Ventas" FontSize="14" />
                        <Label x:Name="CompVentasActual" Grid.Column="1" Text="$0.00"
                               FontSize="14" HorizontalTextAlignment="End" />
                        <Label x:Name="CompVentasAnterior" Grid.Column="2" Text="$0.00"
                               FontSize="14" HorizontalTextAlignment="End" />
                        <Label x:Name="CompVentasDelta" Grid.Column="3" Text="—"
                               FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>

                    <Grid ColumnDefinitions="1.4*,*,*,1.1*" ColumnSpacing="6">
                        <Label Text="Utilidad neta" FontSize="14" FontAttributes="Bold" />
                        <Label x:Name="CompUtilidadActual" Grid.Column="1" Text="$0.00"
                               FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        <Label x:Name="CompUtilidadAnterior" Grid.Column="2" Text="$0.00"
                               FontSize="14" HorizontalTextAlignment="End" />
                        <Label x:Name="CompUtilidadDelta" Grid.Column="3" Text="—"
                               FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>

                    <Grid ColumnDefinitions="1.4*,*,*,1.1*" ColumnSpacing="6">
                        <Label Text="Gastos" FontSize="14" />
                        <Label x:Name="CompGastosActual" Grid.Column="1" Text="$0.00"
                               FontSize="14" HorizontalTextAlignment="End" />
                        <Label x:Name="CompGastosAnterior" Grid.Column="2" Text="$0.00"
                               FontSize="14" HorizontalTextAlignment="End" />
                        <Label x:Name="CompGastosDelta" Grid.Column="3" Text="—"
                               FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>

                    <Label Text="La comparación usa el bloque inmediatamente anterior de la misma duración; el porcentaje no se muestra cuando el periodo anterior vale cero."
                           Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="RangoPanel" IsVisible="False" Style="{StaticResource Tarjeta}" Padding="14">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Desde" Style="{StaticResource EtiquetaSeccion}" />
                        <DatePicker x:Name="DesdePicker" Format="dd/MM/yyyy" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Hasta" Style="{StaticResource EtiquetaSeccion}" />
                        <DatePicker x:Name="HastaPicker" Format="dd/MM/yyyy" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2"
                            Text="Ver"
                            Style="{StaticResource BotonPrincipal}"
                            HeightRequest="40"
                            VerticalOptions="End"
                            Clicked="OnVerRangoClicked" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="PeriodoLabel" Style="{StaticResource EtiquetaSeccion}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="UTILIDAD NETA" Style="{StaticResource EtiquetaSeccion}" />
                            <Label x:Name="UtilidadNetaLabel"
                                   Text="$0.00"
                                   FontSize="30"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                            <Label Text="VENTAS" Style="{StaticResource EtiquetaSeccion}"
                                   HorizontalTextAlignment="End" />
                            <Label x:Name="NumeroVentasLabel"
                                   Text="0"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label x:Name="ResumenVentasLabel" Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="COBROS POR MÉTODO" Style="{StaticResource EtiquetaSeccion}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="EfectivoTituloLabel" Text="Efectivo" FontSize="15" />
                        <Label x:Name="EfectivoMontoLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="TarjetaTituloLabel" Text="Tarjeta" FontSize="15" />
                        <Label x:Name="TarjetaMontoLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="FiadoTituloLabel" Text="Fiado" FontSize="15" />
                        <Label x:Name="FiadoMontoLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>

                    <Label Text="Una venta mixta suma su parte en efectivo y su parte con tarjeta. El fiado se reporta como cuenta por cobrar."
                           Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="DESGLOSE DEL PERIODO" Style="{StaticResource EtiquetaSeccion}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Ventas cobradas" FontSize="15" />
                        <Label x:Name="VentasLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="IVA incluido" FontSize="15" />
                        <Label x:Name="ImpuestoLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Costo de ventas" FontSize="15" />
                        <Label x:Name="CostoLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Comisión de tarjeta" FontSize="15" />
                        <Label x:Name="ComisionLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#D9D9D9" Margin="0,2" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Utilidad bruta" FontSize="16" FontAttributes="Bold" />
                        <Label x:Name="UtilidadBrutaLabel" Grid.Column="1" Text="$0.00"
                               FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Mermas" FontSize="15" />
                        <Label x:Name="MermasLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Gastos" FontSize="15" />
                        <Label x:Name="GastosLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#D9D9D9" Margin="0,2" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Utilidad neta" FontSize="16" FontAttributes="Bold" />
                        <Label x:Name="UtilidadNetaDetalleLabel" Grid.Column="1" Text="$0.00"
                               FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="PRODUCTOS MÁS VENDIDOS" Style="{StaticResource EtiquetaSeccion}" />
                    <Label x:Name="SinProductosLabel"
                           Text="No hay ventas de productos en el periodo."
                           Style="{StaticResource TextoNota}"
                           IsVisible="False" />
                    <VerticalStackLayout x:Name="ProductosLista" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ReporteProductoFila">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Nombre}" FontSize="14" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Utilidad}"
                                           TextColor="{Binding UtilidadColor}"
                                           FontSize="14" FontAttributes="Bold"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detalle}"
                                           Style="{StaticResource TextoNota}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="VENTAS POR CATEGORÍA" Style="{StaticResource EtiquetaSeccion}" />
                    <Label x:Name="SinCategoriasLabel"
                           Text="No hay ventas por categoría en el periodo."
                           Style="{StaticResource TextoNota}"
                           IsVisible="False" />
                    <VerticalStackLayout x:Name="CategoriasLista" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ReporteCategoriaFila">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Nombre}" FontSize="14" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Utilidad}"
                                           TextColor="{Binding UtilidadColor}"
                                           FontSize="14" FontAttributes="Bold"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detalle}"
                                           Style="{StaticResource TextoNota}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="VENTAS POR DÍA" Style="{StaticResource EtiquetaSeccion}" />
                    <Label Text="La utilidad del día descuenta costo y comisión; mermas y gastos se restan en el total del periodo."
                           Style="{StaticResource TextoNota}"
                           FontSize="12" />
                    <Label x:Name="SinDiasLabel"
                           Text="No hay ventas en el periodo."
                           Style="{StaticResource TextoNota}"
                           IsVisible="False" />
                    <VerticalStackLayout x:Name="DiasLista" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ReporteDiaFila">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Nombre}" FontSize="14" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Total}"
                                           FontSize="14" FontAttributes="Bold"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Row="1" Text="{Binding Detalle}"
                                           Style="{StaticResource TextoNota}" FontSize="12" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Utilidad}"
                                           TextColor="{Binding UtilidadColor}"
                                           FontSize="12" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Aviso}">
                <Label Text="Utilidad bruta = ventas − costo de ventas − comisión de tarjeta. Utilidad neta = bruta − mermas − gastos. Las ventas anuladas no se incluyen."
                       FontSize="13"
                       TextColor="#7A4F01" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="ExportarCsvButton"
                        Text="Exportar CSV"
                        Style="{StaticResource BotonSecundario}"
                        IsEnabled="False"
                        Clicked="OnExportarCsvClicked" />
                <Button x:Name="ExportarPdfButton"
                        Grid.Column="1"
                        Text="Exportar PDF"
                        Style="{StaticResource BotonSecundario}"
                        IsEnabled="False"
                        Clicked="OnExportarPdfClicked" />
            </Grid>

            <Label x:Name="MensajeLabel"
                   Style="{StaticResource TextoNota}"
                   HorizontalTextAlignment="Center"
                   IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
