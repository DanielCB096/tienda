<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaTienda.Maui.Pages.ReportesPage"
             Title="Reportes">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Reportes" Style="{StaticResource TituloPagina}" />
                    <Label x:Name="UsuarioLabel" Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Actualizar"
                        Style="{StaticResource BotonSecundario}"
                        WidthRequest="104"
                        HeightRequest="42"
                        VerticalOptions="Center"
                        Clicked="OnActualizarClicked" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button x:Name="HoyButton"
                        Text="Hoy"
                        Style="{StaticResource BotonPrincipal}"
                        HeightRequest="40"
                        Clicked="OnHoyClicked" />
                <Button x:Name="MesButton"
                        Grid.Column="1"
                        Text="Este mes"
                        Style="{StaticResource BotonSecundario}"
                        HeightRequest="40"
                        Clicked="OnMesClicked" />
                <Button x:Name="RangoButton"
                        Grid.Column="2"
                        Text="Rango"
                        Style="{StaticResource BotonSecundario}"
                        HeightRequest="40"
                        Clicked="OnRangoClicked" />
            </Grid>

            <Border x:Name="RangoPanel" IsVisible="False" Style="{StaticResource Tarjeta}" Padding="14">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Desde" Style="{StaticResource EtiquetaSeccion}" />
                        <DatePicker x:Name="DesdePicker" Format="dd/MM/yyyy" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Hasta" Style="{StaticResource EtiquetaSeccion}" />
                        <DatePicker x:Name="HastaPicker" Format="dd/MM/yyyy" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2"
                            Text="Ver"
                            Style="{StaticResource BotonPrincipal}"
                            HeightRequest="40"
                            VerticalOptions="End"
                            Clicked="OnVerRangoClicked" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="PeriodoLabel" Style="{StaticResource EtiquetaSeccion}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="UTILIDAD NETA" Style="{StaticResource EtiquetaSeccion}" />
                            <Label x:Name="UtilidadNetaLabel"
                                   Text="$0.00"
                                   FontSize="30"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                            <Label Text="VENTAS" Style="{StaticResource EtiquetaSeccion}"
                                   HorizontalTextAlignment="End" />
                            <Label x:Name="NumeroVentasLabel"
                                   Text="0"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label x:Name="ResumenVentasLabel" Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="DESGLOSE DEL PERIODO" Style="{StaticResource EtiquetaSeccion}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Ventas cobradas" FontSize="15" />
                        <Label x:Name="VentasLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Costo de ventas" FontSize="15" />
                        <Label x:Name="CostoLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Comisión de tarjeta" FontSize="15" />
                        <Label x:Name="ComisionLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#D9D9D9" Margin="0,2" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Utilidad bruta" FontSize="16" FontAttributes="Bold" />
                        <Label x:Name="UtilidadBrutaLabel" Grid.Column="1" Text="$0.00"
                               FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Mermas" FontSize="15" />
                        <Label x:Name="MermasLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Gastos" FontSize="15" />
                        <Label x:Name="GastosLabel" Grid.Column="1" Text="$0.00"
                               FontSize="15" HorizontalTextAlignment="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#D9D9D9" Margin="0,2" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Utilidad neta" FontSize="16" FontAttributes="Bold" />
                        <Label x:Name="UtilidadNetaDetalleLabel" Grid.Column="1" Text="$0.00"
                               FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Aviso}">
                <Label Text="Utilidad bruta = ventas − costo de ventas − comisión de tarjeta. Utilidad neta = bruta − mermas − gastos. Las ventas anuladas no se incluyen."
                       FontSize="13"
                       TextColor="#7A4F01" />
            </Border>

            <Label x:Name="MensajeLabel"
                   Style="{StaticResource TextoNota}"
                   HorizontalTextAlignment="Center"
                   IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
