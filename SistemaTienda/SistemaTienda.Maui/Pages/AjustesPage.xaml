<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SistemaTienda.Maui.Models"
             x:Class="SistemaTienda.Maui.Pages.AjustesPage"
             Title="Ajustes">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Ajustes" Style="{StaticResource TituloPagina}" />
            <Label x:Name="UsuarioLabel" Style="{StaticResource TextoNota}" Margin="0,0,0,8" />

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="TIENDA" Style="{StaticResource EtiquetaSeccion}" />
                    <Label x:Name="TiendaLabel" FontSize="18" FontAttributes="Bold" />
                    <Label x:Name="DetalleTiendaLabel" Style="{StaticResource TextoNota}" />
                    <Label x:Name="ReglasLabel" Style="{StaticResource TextoNota}" />
                    <Button x:Name="EditarConfiguracionButton"
                            Text="Editar configuración"
                            Style="{StaticResource BotonSecundario}"
                            Clicked="OnEditarConfiguracionClicked"
                            IsVisible="False"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="USUARIOS" Style="{StaticResource EtiquetaSeccion}" />
                    <Label Text="Agrega usuarios y cambia su nombre, rol o PIN. Solo el dueño."
                           Style="{StaticResource TextoNota}" />
                    <Button x:Name="UsuariosButton"
                            Text="Usuarios y PIN"
                            Style="{StaticResource BotonSecundario}"
                            Clicked="OnUsuariosClicked"
                            IsVisible="False"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="AUDITORÍA" Style="{StaticResource EtiquetaSeccion}" />
                    <Label Text="Consulta los movimientos sensibles: ventas anuladas, ajustes, compras, pagos, usuarios y configuración. Solo el dueño."
                           Style="{StaticResource TextoNota}" />
                    <Button x:Name="BitacoraButton"
                            Text="Ver bitácora"
                            Style="{StaticResource BotonSecundario}"
                            Clicked="OnBitacoraClicked"
                            IsVisible="False"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="RESPALDO" Style="{StaticResource EtiquetaSeccion}" />
                    <Label x:Name="UltimoRespaldoLabel" FontSize="18" FontAttributes="Bold" />
                    <Label x:Name="RespaldoDetalleLabel" Style="{StaticResource TextoNota}" />
                    <Button x:Name="CrearRespaldoButton"
                            Text="Crear respaldo ahora"
                            Style="{StaticResource BotonSecundario}"
                            Clicked="OnCrearRespaldoClicked"
                            Margin="0,8,0,0" />
                    <Button x:Name="ExportarRespaldoButton"
                            Text="Exportar respaldo a otro lugar"
                            Style="{StaticResource BotonSecundario}"
                            Clicked="OnExportarRespaldoClicked"
                            IsVisible="False" />
                    <Button x:Name="RestaurarRespaldoButton"
                            Text="Restaurar respaldo"
                            Style="{StaticResource BotonSecundario}"
                            Clicked="OnRestaurarRespaldoClicked"
                            IsVisible="False" />
                    <Label Text="Restaurar reemplaza la base actual y cierra la app. Se guarda un respaldo previo. Solo el dueño."
                           Style="{StaticResource TextoNota}" />
                    <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                        <Switch x:Name="SoporteIncluirBaseSwitch" IsToggled="False" IsVisible="False" />
                        <Label Text="Incluir la base de datos en el paquete de soporte"
                               Style="{StaticResource TextoNota}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button x:Name="SoporteButton"
                            Text="Exportar paquete de soporte"
                            Style="{StaticResource BotonSecundario}"
                            Clicked="OnSoporteClicked"
                            IsVisible="False" />
                    <Label Text="El paquete de soporte puede contener datos del negocio. Compártelo solo por un canal seguro."
                           Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="ALMACENAMIENTO" Style="{StaticResource EtiquetaSeccion}" />
                    <Label Text="Base de datos" Style="{StaticResource TextoNota}" />
                    <Label x:Name="RutaBaseLabel" FontSize="12" LineBreakMode="WordWrap" />
                    <Label Text="Respaldos" Style="{StaticResource TextoNota}" Margin="0,8,0,0" />
                    <Label x:Name="RutaRespaldosLabel" FontSize="12" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Cerrar sesión"
                    Style="{StaticResource BotonSecundario}"
                    Clicked="OnCerrarSesionClicked"
                    Margin="0,8,0,0" />

            <Label Text="SistemaTienda 0.1 · 100 % local, sin conexión a internet."
                   Style="{StaticResource TextoNota}"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>

    <Grid x:Name="ConfigOverlay"
          IsVisible="False"
          BackgroundColor="#99000000"
          Padding="16"
          ZIndex="10">
        <Border Style="{StaticResource Tarjeta}"
                Padding="18"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                MaximumWidthRequest="560">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Editar configuración" FontSize="22" FontAttributes="Bold" />
                    <Label Text="Solo el dueño puede cambiar estos datos. Los cambios aplican a las operaciones nuevas y quedan en la bitácora."
                           Style="{StaticResource TextoNota}" />

                    <Label Text="Nombre de la tienda" Style="{StaticResource EtiquetaSeccion}" Margin="0,8,0,0" />
                    <Entry x:Name="ConfigNombreEntry" Style="{StaticResource CampoTexto}" />

                    <Label Text="Giro del negocio" Style="{StaticResource EtiquetaSeccion}" Margin="0,8,0,0" />
                    <Entry x:Name="ConfigGiroEntry" Style="{StaticResource CampoTexto}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Impuesto (%)" Style="{StaticResource EtiquetaSeccion}" Margin="0,8,0,0" />
                            <Entry x:Name="ConfigImpuestoEntry" Style="{StaticResource CampoTexto}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Comisión tarjeta (%)" Style="{StaticResource EtiquetaSeccion}" Margin="0,8,0,0" />
                            <Entry x:Name="ConfigComisionEntry" Style="{StaticResource CampoTexto}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Fondo de caja inicial ($)" Style="{StaticResource EtiquetaSeccion}" Margin="0,8,0,0" />
                    <Entry x:Name="ConfigFondoEntry" Style="{StaticResource CampoTexto}" Keyboard="Numeric" />

                    <HorizontalStackLayout Spacing="12" Margin="0,8,0,0">
                        <Switch x:Name="ConfigFiadoSwitch" />
                        <Label Text="Activar fiado a clientes" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="Límite de crédito por cliente ($, 0 = sin límite)" Style="{StaticResource EtiquetaSeccion}" Margin="0,8,0,0" />
                    <Entry x:Name="ConfigLimiteEntry" Style="{StaticResource CampoTexto}" Keyboard="Numeric" />

                    <Label Text="Días entre respaldos (0 = deshabilitado)" Style="{StaticResource EtiquetaSeccion}" Margin="0,8,0,0" />
                    <Entry x:Name="ConfigRespaldoEntry" Style="{StaticResource CampoTexto}" Keyboard="Numeric" />

                    <Label x:Name="ConfigErrorLabel" Style="{StaticResource Error}" IsVisible="False" Margin="0,8,0,0" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button x:Name="GuardarConfiguracionButton"
                                Text="Guardar"
                                Style="{StaticResource BotonPrincipal}"
                                Clicked="OnGuardarConfiguracionClicked" />
                        <Button Grid.Column="1"
                                Text="Cancelar"
                                Style="{StaticResource BotonSecundario}"
                                Clicked="OnCancelarConfiguracionClicked" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

    <Grid x:Name="UsuariosOverlay"
          IsVisible="False"
          BackgroundColor="#99000000"
          Padding="16"
          ZIndex="11">
        <Border Style="{StaticResource Tarjeta}"
                Padding="18"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                MaximumWidthRequest="620">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Usuarios y PIN" FontSize="22" FontAttributes="Bold" />
                    <Label Text="Solo el dueño. Los cambios quedan en la bitácora."
                           Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout x:Name="ListaUsuarios" Spacing="8" />
                </ScrollView>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Button Text="+ Nuevo usuario"
                            Style="{StaticResource BotonSecundario}"
                            Clicked="OnNuevoUsuarioClicked" />
                    <Button Grid.Column="1"
                            Text="Cerrar"
                            Style="{StaticResource BotonPrincipal}"
                            Clicked="OnCerrarUsuariosClicked" />
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <Grid x:Name="UsuarioFormOverlay"
          IsVisible="False"
          BackgroundColor="#99000000"
          Padding="16"
          ZIndex="12">
        <Border Style="{StaticResource Tarjeta}"
                Padding="18"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                MaximumWidthRequest="520">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="UsuarioFormTitulo" FontSize="22" FontAttributes="Bold" />

                    <Label Text="Nombre" Style="{StaticResource EtiquetaSeccion}" Margin="0,8,0,0" />
                    <Entry x:Name="UsuarioNombreEntry" Style="{StaticResource CampoTexto}" MaxLength="60" />

                    <Label Text="Rol" Style="{StaticResource EtiquetaSeccion}" Margin="0,8,0,0" />
                    <Picker x:Name="UsuarioRolPicker" Title="Selecciona el rol" />

                    <Label Text="PIN (4 a 6 dígitos)" Style="{StaticResource EtiquetaSeccion}" Margin="0,8,0,0" />
                    <Entry x:Name="UsuarioPinEntry"
                           Style="{StaticResource CampoTexto}"
                           IsPassword="True"
                           Keyboard="Numeric"
                           MaxLength="6" />
                    <Label x:Name="UsuarioFormAyuda"
                           Text="Al editar, deja el PIN vacío para conservarlo."
                           Style="{StaticResource TextoNota}"
                           IsVisible="False" />

                    <Label x:Name="UsuarioFormError" Style="{StaticResource Error}" IsVisible="False" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button x:Name="GuardarUsuarioButton"
                                Text="Guardar"
                                Style="{StaticResource BotonPrincipal}"
                                Clicked="OnGuardarUsuarioClicked" />
                        <Button Grid.Column="1"
                                Text="Cancelar"
                                Style="{StaticResource BotonSecundario}"
                                Clicked="OnCancelarUsuarioClicked" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

    <Grid x:Name="BitacoraOverlay"
          IsVisible="False"
          BackgroundColor="#99000000"
          Padding="16"
          ZIndex="20">
        <Border Style="{StaticResource Tarjeta}"
                Padding="18"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                MaximumWidthRequest="720">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="Bitácora" FontSize="22" FontAttributes="Bold" />
                    <Label Text="Los registros son inmutables: no se editan ni se borran."
                           Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                    <Entry x:Name="BitacoraUsuarioEntry"
                           Style="{StaticResource CampoTexto}"
                           Placeholder="Usuario (opcional)" />
                    <Entry x:Name="BitacoraAccionEntry"
                           Grid.Column="1"
                           Style="{StaticResource CampoTexto}"
                           Placeholder="Acción (opcional)" />
                    <Button Grid.Column="2"
                            Text="Filtrar"
                            Style="{StaticResource BotonSecundario}"
                            Clicked="OnBitacoraFiltrarClicked" />
                </Grid>

                <RefreshView x:Name="BitacoraRefresco"
                             Grid.Row="2"
                             Refreshing="OnBitacoraRefrescando">
                    <CollectionView x:Name="ListaBitacora" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Sin registros que coincidan."
                                   Style="{StaticResource TextoNota}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,24" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:BitacoraFila">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,8">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding Accion}" FontAttributes="Bold" FontSize="15" />
                                        <Label Text="{Binding Entidad}" Style="{StaticResource TextoNota}" />
                                        <Label Text="{Binding Detalle}" Style="{StaticResource TextoNota}" />
                                        <Label Text="{Binding Motivo}"
                                               Style="{StaticResource TextoNota}"
                                               IsVisible="{Binding TieneMotivo}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="End">
                                        <Label Text="{Binding Usuario}" FontSize="13"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding Fecha}" Style="{StaticResource TextoNota}"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <Button Grid.Row="3"
                        Text="Cerrar"
                        Style="{StaticResource BotonPrincipal}"
                        Clicked="OnCerrarBitacoraClicked" />
            </Grid>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
