<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SistemaTienda.Maui.Models"
             x:Class="SistemaTienda.Maui.Pages.VentasPage"
             Title="Ventas">

    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="20,20,20,0" RowSpacing="12">

            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="Ventas de hoy" Style="{StaticResource TituloPagina}" />
                <Label x:Name="ResumenLabel" Style="{StaticResource TextoNota}" />
                <Label Text="Toca una venta para ver el detalle, reimprimir el ticket o anularla."
                       Style="{StaticResource TextoNota}"
                       FontSize="12" />
                <Button Text="Actualizar"
                        Style="{StaticResource BotonSecundario}"
                        Clicked="OnActualizarClicked"
                        HorizontalOptions="Start"
                        Margin="0,8,0,0" />
            </VerticalStackLayout>

            <RefreshView x:Name="Refresco" Grid.Row="1" Refreshing="OnRefrescando">
                <CollectionView x:Name="ListaVentas" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Aún no hay ventas registradas hoy."
                               Style="{StaticResource TextoNota}"
                               HorizontalTextAlignment="Center"
                               Margin="0,40,0,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:VentaFila">
                            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,8" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVentaTapped"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Label Text="{Binding Folio}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding Total}" Grid.Column="1" FontAttributes="Bold" FontSize="18" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding Detalle}" Grid.Row="1" Style="{StaticResource TextoNota}" />
                                    <Label Text="{Binding Estado}" Grid.Row="1" Grid.Column="1"
                                           TextColor="{Binding EstadoColor}" FontSize="13" HorizontalTextAlignment="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <Grid x:Name="DetalleOverlay"
              Grid.RowSpan="2"
              ZIndex="10"
              IsVisible="False"
              BackgroundColor="#99000000">
            <Border Style="{StaticResource Tarjeta}"
                    Margin="20"
                    Padding="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="620"
                    MaximumHeightRequest="680">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="DetalleTituloLabel" FontSize="22" FontAttributes="Bold" />
                                <Label x:Name="DetalleFechaLabel" Style="{StaticResource TextoNota}" />
                            </VerticalStackLayout>
                            <Border x:Name="DetalleEstadoBorder"
                                    Grid.Column="1"
                                    Padding="10,4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center">
                                <Label x:Name="DetalleEstadoLabel"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="12" />
                            </Border>
                        </Grid>

                        <Label x:Name="DetalleMetodoLabel" FontSize="14" />
                        <Label x:Name="DetalleClienteLabel" Style="{StaticResource TextoNota}" IsVisible="False" />

                        <Label Text="Productos" Style="{StaticResource EtiquetaSeccion}" Margin="0,4,0,0" />
                        <VerticalStackLayout x:Name="DetalleLineas" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:LineaVentaFila">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{Binding Importe}" Grid.Column="1" FontAttributes="Bold" />
                                        <Label Text="{Binding Detalle}" Grid.Row="1" Grid.ColumnSpan="2"
                                               Style="{StaticResource TextoNota}" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#D1D5DB" Margin="0,4" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total" FontAttributes="Bold" FontSize="16" />
                            <Label x:Name="DetalleTotalLabel" Grid.Column="1"
                                   FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="End" />
                        </Grid>

                        <Label x:Name="DetallePagosLabel" Style="{StaticResource TextoNota}" />
                        <Label x:Name="DetalleComisionLabel" Style="{StaticResource TextoNota}" IsVisible="False" />

                        <Border x:Name="DetalleAnulacionPanel"
                                Style="{StaticResource Aviso}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Venta anulada" FontAttributes="Bold" TextColor="#7A4F01" />
                                <Label x:Name="DetalleAnulacionLabel" FontSize="13" TextColor="#7A4F01" />
                            </VerticalStackLayout>
                        </Border>

                        <Label x:Name="NotaAnulacionLabel"
                               Text="La anulación devuelve el stock y revierte el fiado. El reembolso en efectivo se entrega manualmente; si la venta ya está en un corte cerrado no se puede anular."
                               Style="{StaticResource TextoNota}"
                               IsVisible="False" />

                        <Button x:Name="AnularButton"
                                Text="Anular venta"
                                Style="{StaticResource BotonPrincipal}"
                                BackgroundColor="#B3261E"
                                IsVisible="False"
                                Clicked="OnAnularClicked" />
                        <Button x:Name="VerTicketButton"
                                Text="Ver ticket"
                                Style="{StaticResource BotonSecundario}"
                                Clicked="OnVerTicketClicked" />
                        <Button Text="Cerrar"
                                Style="{StaticResource BotonSecundario}"
                                Clicked="OnCerrarDetalleClicked" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
