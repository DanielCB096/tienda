<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaTienda.Maui.Pages.CajaPage"
             Title="Caja">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Corte de caja" Style="{StaticResource TituloPagina}" />
            <Label x:Name="PeriodoLabel" Style="{StaticResource TextoNota}" Margin="0,0,0,8" />

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="EFECTIVO ESPERADO" Style="{StaticResource EtiquetaSeccion}" />
                    <Label x:Name="EfectivoLabel" Text="$0.00" Style="{StaticResource ValorGrande}" />
                    <Label x:Name="FondoLabel" Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="MOVIMIENTOS DEL PERIODO" Style="{StaticResource EtiquetaSeccion}" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                        <Label Text="Ventas en efectivo" />
                        <Label x:Name="VentasEfectivoLabel" Grid.Column="1" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="Ventas con tarjeta" />
                        <Label x:Name="VentasTarjetaLabel" Grid.Row="1" Grid.Column="1" FontAttributes="Bold" />
                        <Label Grid.Row="2" Text="Ventas a fiado" />
                        <Label x:Name="VentasFiadoLabel" Grid.Row="2" Grid.Column="1" FontAttributes="Bold" />
                        <Label Grid.Row="3" Text="Abonos en efectivo" />
                        <Label x:Name="AbonosLabel" Grid.Row="3" Grid.Column="1" FontAttributes="Bold" />
                        <Label Grid.Row="4" Text="Ingresos y retiros" />
                        <Label x:Name="MovimientosLabel" Grid.Row="4" Grid.Column="1" FontAttributes="Bold" />
                        <Label Grid.Row="5" Text="Gastos pagados de caja" />
                        <Label x:Name="GastosLabel" Grid.Row="5" Grid.Column="1" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="ÚLTIMO CORTE CERRADO" Style="{StaticResource EtiquetaSeccion}" />
                    <Label x:Name="UltimoCorteLabel" Text="Todavía no hay cortes cerrados." />
                    <Label x:Name="UltimoCorteDetalleLabel" Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Este resumen es informativo. El cierre formal del corte todavía se realiza fuera de esta app."
                   Style="{StaticResource TextoNota}"
                   Margin="0,8,0,0" />

            <Button Text="Actualizar"
                    Style="{StaticResource BotonSecundario}"
                    Clicked="OnActualizarClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
