<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaTienda.Maui.Pages.LoginPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">

    <ScrollView>
        <VerticalStackLayout Padding="20,48" Spacing="12">

            <Label x:Name="NombreTiendaLabel"
                   Text="Mi tienda"
                   Style="{StaticResource TituloPagina}"
                   HorizontalTextAlignment="Center" />

            <Label Text="Acceso al sistema"
                   Style="{StaticResource TextoNota}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,12" />

            <Border Style="{StaticResource Tarjeta}"
                    MinimumWidthRequest="280"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Center">
                <VerticalStackLayout Spacing="12">

                    <Label Text="PIN" Style="{StaticResource EtiquetaSeccion}" />
                    <Entry x:Name="PinEntry"
                           Style="{StaticResource CampoTexto}"
                           IsPassword="True"
                           Keyboard="Numeric"
                           MaxLength="6"
                           Placeholder="4 a 6 dígitos"
                           FontSize="24"
                           HorizontalTextAlignment="Center"
                           Completed="OnEntrarClicked" />

                    <Label x:Name="ErrorLabel"
                           Style="{StaticResource Error}"
                           IsVisible="False" />

                    <Button x:Name="EntrarButton"
                            Text="Entrar"
                            Style="{StaticResource BotonPrincipal}"
                            Clicked="OnEntrarClicked" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Sistema local: los datos se guardan en este dispositivo."
                   Style="{StaticResource TextoNota}"
                   HorizontalTextAlignment="Center"
                   Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
